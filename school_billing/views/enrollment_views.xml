<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_school_enrollment_list" model="ir.ui.view">
        <field name="name">school.enrollment.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="class_id"/>
                <field name="registration_date"/>
                <field name="student_monthly_fee"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_school_enrollment_form" model="ir.ui.view">
        <field name="name">school.enrollment.form</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <form string="Enrollment">
                <sheet>

                    <group>
                        <group string="Student Information">
                            <field name="student_id"/>
                            <field name="academic_year_id"/>

                            <field name="class_id"
                                   domain="[('academic_year_id', '=', academic_year_id)]"/>

                            <field name="registration_date"/>
                        </group>

                        <group string="Billing">
                            <field name="registration_fee"/>
                            <field name="standard_monthly_fee"/>
                            <field name="student_monthly_fee"/>
                            <field name="currency_id"/>
                        </group>
                    </group>

                    <group>
                        <field name="state"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_school_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>